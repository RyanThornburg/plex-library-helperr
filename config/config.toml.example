[settings]
dry_run = true  # for testing, true will not actually move/change/delete any files. Set to false when finished testing.

# Filter time formats are: d | h | m
#   #d for # days (ex: 6d would be 6 days)
#   commented out filter_time if you do not want a filter
filter_time = "1d"

#############################################################
# PLEX
#############################################################
[plex]
baseurl = ''
token = ''

# empty trash (main.py --empty-trash, or the web app, which also runs it after
#   moves/removals/upgrades). Old versions left by upgrades are in the trash too; items
#   with no version left are "fully deleted" and leave the library when emptied.
[plex.empty_trash]
libraries = ['TV Shows']  # omit or [] for every movie/show library
max_items = 100  # skip a library if its trash holds more items than this (protects against a missing mount)
max_deleted_items = 50  # skip a library if more items than this are fully deleted, not counting the removers' deletions
# dry_run = true  # defaults to [settings] dry_run

#############################################################
# AUTOSCAN (optional)
#   When url is set, moved folders (old and new location) are sent to
#   Autoscan's manual trigger instead of refreshing whole Plex libraries.
#   Paths are sent as Radarr/Sonarr see them; use a rewrite on the
#   Autoscan Plex target if Plex sees different paths.
#############################################################
[autoscan]
url = ''
username = ''
password = ''

#############################################################
# TAUTULLI (optional)
#   Watch history for sonarr removers using skip_if_watched_within.
#   Includes partial plays from all users. Without it, Plex history
#   is used (completed plays only).
#############################################################
# [tautulli]
# url = ''
# apikey = ''

#############################################################
# SEERR (optional)
#   Requests and who made them, for the web app's Requests page.
#   Works with Overseerr too.
#############################################################
# [seerr]
# url = ''
# apikey = ''

#############################################################
# SABNZBD (optional)
#   Queue, speed, warnings and failed downloads, for the web
#   app's Status page.
#############################################################
# [sabnzbd]
# url = ''
# apikey = ''

#############################################################
# RADARR
#############################################################
[radarr]
baseurl = ''
apikey = ''
tag = 'helperr'

# documentary
[[radarr.movers]]
path = '/movies/movies-documentary'
plex_library = 'Documentary'
genres = ['documentary']
genre_match = 'any'
exclude_genres = ['comedy', 'action', 'drama']
exclude_paths = ['/movies/movies-kids']

# g rated disney
[[radarr.movers]]
plex_library = 'Kids Movies'
path = '/movies/movies-kids'
genres = ['family']
genre_match = 'any'
certifications = ['G']
studios = ['Walt Disney Pictures']

# profiler
[[radarr.profilers]]
profile = 'NoDownload'
titles = ['Melania']
monitored = false

#############################################################
# SONARR
#############################################################
[sonarr]
baseurl = ''
apikey = ''
tag = 'helperr'

# move based on family + animation - any rating
[[sonarr.movers]]
plex_library = 'Kids TV Shows'
path = '/tv/tv-kids'
genres = ['family', 'animation']
genre_match = 'all'
certifications = ['G', 'TV-Y7']

# kids networks
[[sonarr.movers]]
plex_library = 'Kids TV Shows'
path = '/tv/tv-kids'
networks = [
    "Playhouse Disney",
    "Disney Channel",
    "Toon Disney",
    "Nickelodeon",
    "Nick Jr.",
]

#############################################################
# SONARR REMOVERS
#   Unmonitor then DELETE files of old seasons/episodes from series
#   tagged in sonarr. filter_time is not used. Removers only plan: the web
#   app deletes what you approve, or a rule's removals with auto-approve on.
#############################################################
[sonarr.remover_settings]
max_deletes = 200  # remove nothing if a run would delete more files than this (plans for review don't count)

# keep the latest 2 seasons of series tagged rm-keep-2-seasons
[[sonarr.removers]]
type = 'seasons'
keep = 2
tags = ['rm-keep-2-seasons']
exclude_tags = ['rm-never']
min_age = '90d'  # every file in a season must be older than this (required)
skip_if_watched_within = '30d'  # needs [tautulli] or [plex]
plex_library = 'TV Shows'

# keep the latest 10 episodes (daily/talk shows)
[[sonarr.removers]]
type = 'episodes'
keep = 10
tags = ['rm-keep-10-episodes']
min_age = '14d'
include_specials = true  # specials never count toward keep
